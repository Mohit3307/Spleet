@using Spleet.Models
@model Spleet.ViewModels.ExpenseCreateViewModel

@{
    ViewData["Title"] = "Add Expense";
}

<div class="container">

    <div class="dashboard-hero">

        <div>
            <p class="eyebrow">NEW EXPENSE</p>
            <h1>Add expense</h1>

            <p class="page-subtitle">
                Record a shared expense and choose how it is split.
            </p>
        </div>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card">

                <div class="card-body">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="GroupId" />

                        <div asp-validation-summary="ModelOnly"
                             class="validation-summary mb-4">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <input asp-for="Description"
                                   class="form-control"
                                   placeholder="e.g. Dinner" />

                            <span asp-validation-for="Description"
                                  class="field-error">
                            </span>

                        </div>


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Amount"
                                       class="form-label">
                                    Amount
                                </label>

                                <input asp-for="Amount"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       placeholder="0.00" />

                                <span asp-validation-for="Amount"
                                      class="field-error">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="Category"
                                       class="form-label">
                                    Category
                                </label>

                                <input asp-for="Category"
                                       class="form-control"
                                       placeholder="food" />

                            </div>

                        </div>


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="PaidByUserId"
                                       class="form-label">
                                    Paid by
                                </label>

                                <select asp-for="PaidByUserId"
                                        class="form-select">

                                    @foreach (var member in Model.Members)
                                    {
                                        <option value="@member.UserId">
                                            @member.Name
                                        </option>
                                    }

                                </select>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="ExpenseDate"
                                       class="form-label">
                                    Expense date
                                </label>

                                <input asp-for="ExpenseDate"
                                       class="form-control"
                                       type="date" />

                            </div>

                        </div>


                        <div class="mb-4">

                            <label asp-for="SplitType"
                                   class="form-label">
                                Split type
                            </label>

                            <select asp-for="SplitType"
                                    class="form-select"
                                    id="splitType">

                                <option value="@SplitType.Equal">
                                    Equal
                                </option>

                                <option value="@SplitType.Custom">
                                    Custom
                                </option>

                            </select>

                        </div>


                        <div class="mb-4">

                            <label class="form-label">
                                Split between
                            </label>

                            <div class="card">

                                <div class="card-body">

                                    @foreach (var member in Model.Members)
                                    {
                                        <div class="split-member
                                                    custom-share-row">

                                            <div class="form-check">

                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="SelectedUserIds"
                                                       value="@member.UserId"
                                                       checked="@Model.SelectedUserIds.Contains(member.UserId)" />

                                                <label class="form-check-label">
                                                    @member.Name
                                                    <span class="text-muted small">
                                                        @member.Email
                                                    </span>
                                                </label>

                                            </div>

                                            <div class="custom-share mt-2"
                                                 data-user-id="@member.UserId">

                                                <input type="number"
                                                       name="CustomShares[@member.UserId]"
                                                       class="form-control custom-share-input"
                                                       step="0.01"
                                                       min="0"
                                                       placeholder="Share"
                                                       disabled />

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="primary-button">
                                Add expense
                            </button>

                            <a asp-controller="Groups"
                               asp-action="Details"
                               asp-route-id="@Model.GroupId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const splitType =
            document.getElementById("splitType");

        const customRows =
            document.querySelectorAll(".custom-share");

        function updateCustomVisibility() {

            const isCustom =
                splitType.value === "Custom";

            customRows.forEach(row => {

                const input =
                    row.querySelector(".custom-share-input");

                if (!input)
                    return;

                input.disabled = !isCustom;

                if (!isCustom) {
                    input.value = "";
                }

            });
        }

        splitType.addEventListener(
            "change",
            updateCustomVisibility
        );

        updateCustomVisibility();

    </script>
}