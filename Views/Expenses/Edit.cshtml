@using Spleet.Models
@model Spleet.ViewModels.ExpenseEditViewModel

@{
    ViewData["Title"] = "Edit Expense";
}

<div class="container">

    <div class="dashboard-hero">

        <div>
            <p class="eyebrow">EDIT EXPENSE</p>

            <h1>
                Edit expense
            </h1>

            <p class="page-subtitle">
                Update the expense and its split.
            </p>
        </div>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card">

                <div class="card-body">

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <input type="hidden"
                               asp-for="GroupId" />


                        <div asp-validation-summary="ModelOnly"
                             class="validation-summary mb-4">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <input asp-for="Description"
                                   class="form-control" />

                            <span asp-validation-for="Description"
                                  class="field-error">
                            </span>

                        </div>


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Amount"
                                       class="form-label">
                                    Amount
                                </label>

                                <input asp-for="Amount"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0.01" />

                                <span asp-validation-for="Amount"
                                      class="field-error">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Category"
                                       class="form-label">
                                    Category
                                </label>

                                <input asp-for="Category"
                                       class="form-control" />

                            </div>

                        </div>


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="PaidByUserId"
                                       class="form-label">
                                    Paid by
                                </label>

                                <select asp-for="PaidByUserId"
                                        class="form-select">

                                    @foreach (var member in Model.Members)
                                    {
                                        <option value="@member.UserId">
                                            @member.Name
                                        </option>
                                    }

                                </select>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="ExpenseDate"
                                       class="form-label">
                                    Expense date
                                </label>

                                <input asp-for="ExpenseDate"
                                       class="form-control"
                                       type="date" />

                            </div>

                        </div>


                        <div class="mb-4">

                            <label asp-for="SplitType"
                                   class="form-label">
                                Split type
                            </label>

                            <select asp-for="SplitType"
                                    class="form-select"
                                    id="splitType">

                                <option value="@SplitType.Equal">
                                    Equal
                                </option>

                                <option value="@SplitType.Custom">
                                    Custom
                                </option>

                            </select>

                        </div>


                        <div class="mb-4">

                            <label class="form-label">
                                Split between
                            </label>

                            <div class="card">

                                <div class="card-body">

                                    @foreach (var member in Model.Members)
                                    {
                                        var selected =
                                            Model.SelectedUserIds.Contains(
                                                member.UserId);

                                        var share =
                                            Model.CustomShares.TryGetValue(
                                                member.UserId,
                                                out var existingShare)
                                                ? existingShare
                                                : 0m;

                                        <div class="custom-share-row">

                                            <div class="form-check">

                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="SelectedUserIds"
                                                       value="@member.UserId"
                                                       checked="@selected" />

                                                <label class="form-check-label">

                                                    @member.Name

                                                </label>

                                            </div>

                                            <div class="custom-share mt-2">

                                                <input type="number"
                                                       name="CustomShares[@member.UserId]"
                                                       class="form-control custom-share-input"
                                                       step="0.01"
                                                       min="0"
                                                       value="@share"
                                                       disabled />

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="primary-button">
                                Save changes
                            </button>

                            <a asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const splitType =
            document.getElementById("splitType");

        const customInputs =
            document.querySelectorAll(
                ".custom-share-input"
            );

        function updateCustomVisibility() {

            const isCustom =
                splitType.value === "Custom";

            customInputs.forEach(input => {

                input.disabled = !isCustom;

            });
        }

        splitType.addEventListener(
            "change",
            updateCustomVisibility
        );

        updateCustomVisibility();

    </script>
}