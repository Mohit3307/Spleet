@using Spleet.Models
@model Spleet.ViewModels.ExpenseEditViewModel
@{
    ViewData["Title"] = "Edit Expense";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1>Edit Expense</h1>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="GroupId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Amount" class="form-label">Amount</label>
                        <input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label">Category</label>
                        <select asp-for="Category" class="form-select">
                            <option value="general">General</option>
                            <option value="food">Food</option>
                            <option value="travel">Travel</option>
                            <option value="rent">Rent</option>
                            <option value="utilities">Utilities</option>
                            <option value="shopping">Shopping</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="PaidByUserId" class="form-label">Paid by</label>
                    <select asp-for="PaidByUserId" class="form-select">
                        @foreach (var member in Model.Members)
                        {
                            <option value="@member.UserId">@member.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Split between</label>
                    <div class="border rounded p-3">
                        @foreach (var member in Model.Members)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox"
                                       name="SelectedUserIds"
                                       value="@member.UserId"
                                       id="member-@member.UserId"
                                       @(Model.SelectedUserIds.Contains(member.UserId) ? "checked" : "") />
                                <label class="form-check-label" for="member-@member.UserId">@member.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="SplitType" class="form-label">Split type</label>
                    <select asp-for="SplitType" class="form-select" id="splitType">
                        <option value="@SplitType.Equal">Equal</option>
                        <option value="@SplitType.Custom">Custom amounts</option>
                    </select>
                </div>

                <div id="customShares" class="mb-3">
                    <label class="form-label">Custom shares</label>
                    <div class="border rounded p-3">
                        @foreach (var member in Model.Members)
                        {
                            <div class="row align-items-center mb-2">
                                <div class="col">@member.Name</div>
                                <div class="col-auto">
                                    <input type="number"
                                           class="form-control"
                                           name="CustomShares[@member.UserId]"
                                           value="@(Model.CustomShares.TryGetValue(member.UserId, out var value) ? value.ToString("0.00") : "")"
                                           min="0.01" step="0.01"
                                           style="width:140px" />
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ExpenseDate" class="form-label">Expense date</label>
                    <input asp-for="ExpenseDate" class="form-control" type="date" />
                </div>

                <button class="btn btn-primary" type="submit">Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateCustomVisibility() {
            const custom = document.getElementById("splitType").value === "Custom";
            document.getElementById("customShares").classList.toggle("d-none", !custom);
        }
        document.getElementById("splitType").addEventListener("change", updateCustomVisibility);
        updateCustomVisibility();
    </script>
}
