@using Spleet.Models
@model IEnumerable<Expense>

@{
    ViewData["Title"] = "Expenses";
    var groupId = ViewBag.GroupId;
}

<div class="container">

    <div class="dashboard-hero">

        <div>
            <p class="eyebrow">EXPENSES</p>
            <h1>Expenses</h1>

            <p class="page-subtitle">
                Track everything your group has paid for.
            </p>
        </div>

        <a asp-action="Create"
           asp-route-groupId="@groupId"
           class="primary-button">

            + Add expense

        </a>

    </div>


    <div class="section-block">

        <div class="section-heading">

            <h2>All expenses</h2>

            <a asp-controller="Groups"
               asp-action="Details"
               asp-route-id="@groupId"
               class="text-link">
                Back to group
            </a>

        </div>


        @if (!Model.Any())
        {
            <div class="empty-card">

                <div class="empty-icon">
                    ₹
                </div>

                <h3>No expenses yet</h3>

                <p>
                    Add an expense to start tracking who paid
                    and who owes what.
                </p>

                <a asp-action="Create"
                   asp-route-groupId="@groupId"
                   class="primary-button">
                    Add expense
                </a>

            </div>
        }
        else
        {
            <div class="card">

                <div class="list-group list-group-flush">

                    @foreach (var expense in Model)
                    {
                        <a asp-action="Details"
                           asp-route-id="@expense.Id"
                           class="list-group-item
                                  list-group-item-action">

                            <div class="d-flex
                                        justify-content-between
                                        align-items-center">

                                <div>

                                    <strong>
                                        @expense.Description
                                    </strong>

                                    <div class="text-muted small">

                                        Paid by
                                        @(expense.PaidBy?.FullName
                                            ?? expense.PaidBy?.UserName
                                            ?? "Unknown")

                                        ·

                                        @(expense.ExpenseDate
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy"))

                                    </div>

                                </div>

                                <div class="text-end">

                                    <strong>
                                        @expense.Amount.ToString("0.00")
                                    </strong>

                                    <div>
                                        <span class="badge
                                            bg-light
                                            text-dark
                                            border">

                                            @expense.Category

                                        </span>
                                    </div>

                                </div>

                            </div>

                        </a>
                    }

                </div>

            </div>
        }

    </div>

</div>