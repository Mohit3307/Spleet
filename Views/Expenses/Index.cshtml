
@using Spleet.Models
@model IEnumerable<Expense>

@{
    ViewData["Title"] = "Expenses";
    var groupId = ViewBag.GroupId;
}

<div class="container">

    <div class="dashboard-hero">
        <div>
            <p class="eyebrow">EXPENSES</p>
            <h1>Expenses</h1>
            <p class="page-subtitle">
                Track what your group spends, shares, and actually pays.
            </p>
        </div>

        <a asp-action="Create"
           asp-route-groupId="@groupId"
           class="primary-button">
            + Add expense
        </a>
    </div>

    <div class="section-block">

        <div class="section-heading">
            <h2>All expenses</h2>

            <a asp-controller="Groups"
               asp-action="Details"
               asp-route-id="@groupId"
               class="text-link">
                Back to group
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-card">
                <div class="empty-icon">₹</div>

                <h3>No expenses yet</h3>

                <p>
                    Add an expense to start tracking who paid
                    and who owes what.
                </p>

                <a asp-action="Create"
                   asp-route-groupId="@groupId"
                   class="primary-button">
                    Add expense
                </a>
            </div>
        }
        else
        {
            <div class="card">
                <div class="list-group list-group-flush">

                    @foreach (var expense in Model)
                    {
                        var sharesTotal = expense.Splits?
                            .Sum(s => s.ShareAmount) ?? 0m;

                        var contributionsTotal = expense.Contributions?
                            .Sum(c => c.Amount) ?? 0m;

                        <a asp-action="Details"
                           asp-route-id="@expense.Id"
                           class="list-group-item list-group-item-action py-3">

                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">

                                <div class="flex-grow-1">
                                    <strong class="d-block mb-1">
                                        @expense.Description
                                    </strong>

                                    <div class="text-muted small mb-2">
                                        Paid by
                                        @(expense.PaidBy?.FullName
                                            ?? expense.PaidBy?.UserName
                                            ?? "Unknown")
                                        ·
                                        @expense.ExpenseDate
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy")
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">
                                            @expense.Category
                                        </span>

                                        <span class="badge bg-light text-dark border">
                                            @expense.SplitType split
                                        </span>
                                    </div>
                                </div>

                                <div class="text-end">
                                    <strong class="d-block fs-5">
                                        @expense.Amount.ToString("N2")
                                    </strong>

                                    <div class="text-muted small mt-2">
                                        Shares:
                                        <strong>
                                            @sharesTotal.ToString("N2")
                                        </strong>
                                    </div>

                                    <div class="text-muted small">
                                        Actually paid:
                                        <strong>
                                            @contributionsTotal.ToString("N2")
                                        </strong>
                                    </div>

                                    @if (expense.Contributions == null ||
                                         !expense.Contributions.Any())
                                    {
                                        <span class="badge bg-warning text-dark mt-2">
                                            No contributions recorded
                                        </span>
                                    }
                                </div>

                            </div>
                        </a>
                    }

                </div>
            </div>
        }

    </div>
</div>
