@using Spleet.Models
@model Group

@{
    ViewData["Title"] = Model.Name;

    var recentExpenses =
        ViewBag.RecentExpenses as IEnumerable<Expense>
        ?? Enumerable.Empty<Expense>();

    var balances =
        ViewBag.Balances as Dictionary<Guid, decimal>
        ?? new Dictionary<Guid, decimal>();
}

<div class="container py-5">

    <!-- GROUP HEADER -->
    <div class="mb-4">

        <div class="eyebrow">
            GROUP
        </div>

        <h1 class="display-5 fw-semibold mb-2">
            @Model.Name
        </h1>

        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge bg-light border text-dark">
                @Model.GroupType
            </span>

            <span class="badge bg-light border text-dark">
                @Model.CurrencyCode
            </span>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Groups
        </a>

    </div>


    <div class="row g-4">

        <!-- =========================
             LEFT SIDE
             ========================= -->
        <div class="col-lg-8">

            <!-- MEMBERS -->
            <section class="mb-4">

                <div class="section-heading">
                    <h2>Members</h2>
                </div>

                <div class="card shadow-sm">

                    <div class="list-group list-group-flush">

                        @foreach (var member in Model.Members)
                        {
                            var name =
                                member.User?.FullName
                                ?? member.User?.UserName
                                ?? "Unknown user";

                            var email =
                                member.User?.Email
                                ?? "";

                            var balance = 0m;

                            if (balances.TryGetValue(
                                member.UserId,
                                out var calculatedBalance))
                            {
                                balance = calculatedBalance;
                            }

                            var initial =
                                string.IsNullOrWhiteSpace(name)
                                    ? "U"
                                    : name.Substring(0, 1).ToUpperInvariant();

                            <div class="list-group-item">

                                <div class="d-flex justify-content-between align-items-start gap-3">

                                    <div class="d-flex align-items-start gap-3">

                                        <!-- Avatar -->
                                        <div class="group-icon">
                                            @initial
                                        </div>

                                        <div>

                                            <div class="fw-semibold">
                                                @name
                                            </div>

                                            <div class="text-muted small">
                                                @email
                                            </div>

                                            @if (balance > 0.005m)
                                            {
                                                <div class="balance-positive">
                                                    Receives
                                                    @Model.CurrencyCode
                                                    @balance.ToString("0.00")
                                                </div>
                                            }
                                            else if (balance < -0.005m)
                                            {
                                                <div class="balance-negative">
                                                    Owes
                                                    @Model.CurrencyCode
                                                    @Math.Abs(balance).ToString("0.00")
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="balance-neutral">
                                                    Settled
                                                </div>
                                            }

                                        </div>

                                    </div>

                                    <span class="badge @(member.Role == GroupRole.Admin
                                        ? "bg-primary"
                                        : "bg-secondary")">
                                        @member.Role
                                    </span>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </section>


            <!-- ADD MEMBER -->
            <section class="mb-4">

                <div class="section-heading">
                    <h2>Add a member</h2>
                </div>

                <div class="card shadow-sm">

                    <div class="card-body">

                        <p class="text-muted">
                            Add an existing Spleet user using their
                            registered email address.
                        </p>

                        <!--
                            Member adding is not connected to a controller
                            action yet, so this remains UI-only for now.
                        -->
                        <div class="input-group">

                            <input type="email"
                                   class="form-control"
                                   placeholder="user@example.com" />

                            <button type="button"
                                    class="btn btn-primary">
                                Add User
                            </button>

                        </div>

                    </div>

                </div>

            </section>


            <!-- RECENT EXPENSES -->
            <section>

                <div class="section-heading">

                    <h2>
                        Recent expenses
                    </h2>

                    <a asp-controller="Expenses"
                       asp-action="Index"
                       asp-route-groupId="@Model.Id"
                       class="text-link">
                        View all
                    </a>

                </div>


                <div class="card shadow-sm">

                    @if (!recentExpenses.Any())
                    {
                        <div class="card-body text-center">

                            <p class="text-muted mb-3">
                                No expenses have been added yet.
                            </p>

                            <a asp-controller="Expenses"
                               asp-action="Create"
                               asp-route-groupId="@Model.Id"
                               class="btn btn-primary">
                                Add your first expense
                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">

                            @foreach (var expense in recentExpenses)
                            {
                                <a asp-controller="Expenses"
                                   asp-action="Details"
                                   asp-route-id="@expense.Id"
                                   class="list-group-item list-group-item-action">

                                    <div class="d-flex justify-content-between align-items-center gap-3">

                                        <div>

                                            <div class="fw-semibold">
                                                @expense.Description
                                            </div>

                                            <div class="text-muted small">

                                                Paid by
                                                @(expense.PaidBy?.FullName
                                                    ?? expense.PaidBy?.UserName
                                                    ?? "Unknown")

                                                ·

                                                @expense.ExpenseDate
                                                    .ToLocalTime()
                                                    .ToString("dd MMM yyyy")

                                            </div>

                                        </div>

                                        <div class="text-end">

                                            <strong>
                                                @Model.CurrencyCode
                                                @expense.Amount.ToString("0.00")
                                            </strong>

                                            <div>
                                                <span class="badge bg-light text-dark border">
                                                    @expense.Category
                                                </span>
                                            </div>

                                        </div>

                                    </div>

                                </a>
                            }

                        </div>
                    }

                </div>

            </section>

        </div>


        <!-- =========================
             RIGHT SIDE
             ========================= -->
        <div class="col-lg-4">

            <section>

                <div class="section-heading">
                    <h2>Group actions</h2>
                </div>

                <div class="card shadow-sm">

                    <div class="card-body d-grid gap-2">

                        <!-- ADD EXPENSE -->
                        <a asp-controller="Expenses"
                           asp-action="Create"
                           asp-route-groupId="@Model.Id"
                           class="btn btn-primary">
                            + Add expense
                        </a>


                        <!-- ALL EXPENSES -->
                        <a asp-controller="Expenses"
                           asp-action="Index"
                           asp-route-groupId="@Model.Id"
                           class="btn btn-outline-primary">
                            All expenses
                        </a>


                        <!-- SETTLE UP -->
                        <a asp-controller="Settlements"
                           asp-action="Index"
                           asp-route-groupId="@Model.Id"
                           class="btn btn-outline-success">
                            Settle up
                        </a>


                        <!-- INVITE -->
                        <a href="#"
                           class="btn btn-outline-secondary">
                            Create invite link
                        </a>


                        <hr class="my-2" />


                        <!-- ARCHIVE -->
                        <form asp-action="Archive"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger w-100"
                                    onclick="return confirm('Archive this group?');">
                                Archive group
                            </button>

                        </form>

                    </div>

                </div>

            </section>

        </div>

    </div>

</div>