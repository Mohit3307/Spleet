@using Spleet.Models
@model IEnumerable<Group>

@{
    ViewData["Title"] = "Groups";
}

<div class="container">

    <div class="dashboard-hero">
        <div>
            <p class="eyebrow">YOUR GROUPS</p>
            <h1>Groups</h1>
            <p class="page-subtitle">
                Manage your shared expenses and members.
            </p>
        </div>

        <a asp-action="Create" class="primary-button">
            + Create group
        </a>
    </div>

    <div class="section-block">

        <div class="section-heading">
            <h2>Your groups</h2>

            <span class="text-muted small">
                @Model.Count() active group@(Model.Count() == 1 ? "" : "s")
            </span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-card">

                <div class="empty-icon">
                    G
                </div>

                <h3>No groups yet</h3>

                <p>
                    Create your first group to start sharing
                    expenses with friends, roommates or family.
                </p>

                <a asp-action="Create"
                   class="primary-button">
                    Create your first group
                </a>

            </div>
        }
        else
        {
            <div class="group-grid">

                @foreach (var group in Model)
                {
                    <a asp-action="Details"
                       asp-route-id="@group.Id"
                       class="group-card">

                        <div class="group-icon">
                            @group.Name.Substring(0, 1).ToUpper()
                        </div>

                        <div class="group-card-body">

                            <h3>
                                @group.Name
                            </h3>

                            <p>
                                @(string.IsNullOrWhiteSpace(group.Description)
                                    ? "No description"
                                    : group.Description)
                            </p>

                            <div class="mt-2">
                                <span class="badge bg-secondary">
                                    @group.GroupType
                                </span>

                                <span class="badge bg-light text-dark border">
                                    @group.CurrencyCode
                                </span>
                            </div>

                        </div>

                        <span class="group-arrow">
                            →
                        </span>

                    </a>
                }

            </div>
        }

    </div>

</div>