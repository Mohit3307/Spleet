@using Spleet.Models
@model IEnumerable<Group>

@{
    ViewData["Title"] = "Dashboard";

    var user = ViewBag.User as User;
}

<div class="dashboard-page">

    <!-- Dashboard Header -->
    <section class="dashboard-header">

        <div>
            <p class="eyebrow">DASHBOARD</p>

            <h1>
                Welcome,
                @(string.IsNullOrWhiteSpace(user?.FullName)
                    ? user?.UserName
                    : user.FullName)
            </h1>

            <p class="dashboard-subtitle">
                Manage your groups, expenses and settlements.
            </p>
        </div>

        <div class="dashboard-actions">

            <a asp-controller="Groups"
               asp-action="Create"
               class="btn btn-primary">
                + Create Group
            </a>

        </div>

    </section>


    <!-- Quick Actions -->
    <section class="dashboard-section">

        <div class="section-heading">
            <div>
                <p class="eyebrow">QUICK ACTIONS</p>
                <h2>What do you want to do?</h2>
            </div>
        </div>

        <div class="quick-actions">

            <a asp-controller="Groups"
               asp-action="Create"
               class="quick-action-card">

                <div class="quick-action-icon">
                    +
                </div>

                <div>
                    <h3>Create Group</h3>
                    <p>
                        Start a new expense-sharing group.
                    </p>
                </div>

            </a>

            <a asp-controller="Groups"
               asp-action="Index"
               class="quick-action-card">

                <div class="quick-action-icon">
                    →
                </div>

                <div>
                    <h3>View Groups</h3>
                    <p>
                        Open one of your existing groups.
                    </p>
                </div>

            </a>

        </div>

    </section>


    <!-- Groups -->
    <section class="dashboard-section">

        <div class="section-heading">

            <div>
                <p class="eyebrow">YOUR GROUPS</p>
                <h2>Groups</h2>
            </div>

            <a asp-controller="Groups"
               asp-action="Index"
               class="btn btn-outline-primary">
                View All
            </a>

        </div>


        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    +
                </div>

                <h3>No groups yet</h3>

                <p>
                    Create your first group to start sharing expenses.
                </p>

                <a asp-controller="Groups"
                   asp-action="Create"
                   class="btn btn-primary">
                    Create Your First Group
                </a>

            </div>
        }
        else
        {
            <div class="group-grid">

                @foreach (var group in Model)
                {
                    <a asp-controller="Groups"
                       asp-action="Details"
                       asp-route-id="@group.Id"
                       class="group-card">

                        <div class="group-card-top">

                            <div class="group-icon">
                                @group.Name.Substring(0, 1).ToUpper()
                            </div>

                            <span class="group-currency">
                                @group.CurrencyCode
                            </span>

                        </div>


                        <div class="group-card-content">

                            <h3>
                                @group.Name
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(group.Description))
                            {
                                <p>
                                    @group.Description
                                </p>
                            }
                            else
                            {
                                <p>
                                    @group.GroupType
                                </p>
                            }

                        </div>


                        <div class="group-card-footer">

                            <span>
                                Open group
                            </span>

                            <span class="group-arrow">
                                →
                            </span>

                        </div>

                    </a>
                }

            </div>
        }

    </section>

</div>