@using Spleet.Models
@model Settlement

@{
    ViewData["Title"] = "Settlement Details";

    var payerName = Model.Payer?.FullName ?? Model.Payer?.UserName ?? "User";
    var payeeName = Model.Payee?.FullName ?? Model.Payee?.UserName ?? "User";
    Guid? currentUserId = ViewBag.CurrentUserId;
    bool isPayee = currentUserId.HasValue && currentUserId.Value == Model.PayeeUserId;
    bool isPayer = currentUserId.HasValue && currentUserId.Value == Model.PayerUserId;

    var statusClass = Model.Status switch
    {
        SettlementStatus.Pending => "settlement-status settlement-status-pending",
        SettlementStatus.Completed => "settlement-status settlement-status-confirmed",
        SettlementStatus.Disputed => "settlement-status settlement-status-disputed",
        _ => "settlement-status"
    };
}

<div class="settlement-page">
    <div class="settlement-header">
        <div>
            <span class="eyebrow">Settle Up</span>
            <h1>Settlement Details</h1>
            <p class="settlement-route">
                <span>@payerName</span>
                <span class="settlement-arrow">→</span>
                <span>@payeeName</span>
            </p>
        </div>

        <a asp-action="Index"
           asp-route-groupId="@Model.GroupId"
           class="btn btn-outline-secondary">
            Back to Settle Up
        </a>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger settlement-alert">
            @error
        </div>
    }

    <div class="settlement-layout">
        <section class="settlement-main-card">
            <div class="settlement-card-top">
                <div>
                    <span class="settlement-label">Payment amount</span>
                    <div class="settlement-amount">
                        @Model.Amount.ToString("0.00")
                    </div>
                </div>

                <span class="@statusClass">
                    @Model.Status
                </span>
            </div>

            <div class="settlement-info-grid">
                <div class="settlement-info-item">
                    <span>From</span>
                    <strong>@payerName</strong>
                </div>

                <div class="settlement-info-item">
                    <span>To</span>
                    <strong>@payeeName</strong>
                </div>

                <div class="settlement-info-item">
                    <span>Created</span>
                    <strong>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong>
                </div>

                @if (Model.AutoConfirmDeadline.HasValue && Model.Status == SettlementStatus.Pending)
                {
                    <div class="settlement-info-item">
                        <span>Auto-confirm</span>
                        <strong>@Model.AutoConfirmDeadline.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <div class="settlement-note">
                    <span>Note</span>
                    <p>@Model.Note</p>
                </div>
            }
        </section>

        @if (Model.Status == SettlementStatus.Pending)
        {
            if (isPayee)
            {
                <section class="settlement-action-card">
                    <div>
                        <span class="settlement-label">Action required</span>
                        <h2>Review this payment</h2>
                        <p>
                            @payerName marked this payment as paid. Confirm it if you received
                            the money, or dispute it if something is wrong.
                        </p>
                    </div>
                    <div class="settlement-actions">
                        <form asp-action="Confirm" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-success" type="submit">Confirm Payment</button>
                        </form>
                        <form asp-action="Dispute" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-outline-danger" type="submit">Dispute Payment</button>
                        </form>
                    </div>
                </section>
            }
            else if (isPayer)
            {
                <section class="settlement-action-card">
                    <span class="settlement-label">Payment submitted</span>
                    <h2>Waiting for @payeeName</h2>
                    <p>You marked this payment as paid. The recipient must confirm that it was received.</p>
                    @if (Model.AutoConfirmDeadline.HasValue)
                    {
                        <div class="settlement-note">
                            <span>Auto-confirm</span>
                            <p>If it is not disputed, this payment is scheduled to auto-confirm on @Model.AutoConfirmDeadline.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm").</p>
                        </div>
                    }
                </section>
            }
            else
            {
                <section class="settlement-action-card">
                    <span class="settlement-label">Payment pending</span>
                    <h2>Settlement in progress</h2>
                    <p>This payment is waiting for confirmation from the recipient.</p>
                </section>
            }
        }
        else
        {
            <section class="settlement-action-card settlement-complete-card">
                <span class="settlement-label">Settlement status</span>
                <h2>
                    @if (Model.Status == SettlementStatus.Completed)
                    {
                        @:Payment confirmed
                    }
                    else if (Model.Status == SettlementStatus.Disputed)
                    {
                        @:Payment disputed
                    }
                    else
                    {
                        @:Settlement updated
                    }
                </h2>
                <p>
                    This settlement no longer requires an action from you.
                </p>
            </section>
        }
    </div>

    <div class="settlement-bottom-link">
        <a asp-action="Index"
           asp-route-groupId="@Model.GroupId"
           class="text-link">
            ← Back to Settle Up
        </a>
    </div>
</div>
