
@using Spleet.Models
@model Spleet.ViewModels.SettlementViewModel

@{
    var group = (Group)ViewBag.Group;
    ViewData["Title"] = "Settle Up - " + group.Name;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Settle Up</h1>
            <p class="text-muted mb-0">@group.Name</p>
        </div>

        <a asp-controller="Groups"
           asp-action="Details"
           asp-route-id="@group.Id"
           class="btn btn-outline-secondary">
            Group
        </a>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    @* Suggested payments *@
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Suggested payments</h5>
        </div>

        <div class="card-body">
            @if (!Model.Suggestions.Any())
            {
                <p class="text-success mb-0">Everyone is settled up.</p>
            }
            else
            {
                @foreach (var suggestion in Model.Suggestions)
                {
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <strong>@suggestion.PayerName</strong>
                                <span class="text-muted"> pays </span>
                                <strong>@suggestion.PayeeName</strong>
                            </div>

                            <strong>
                                @group.CurrencyCode
                                @suggestion.Amount.ToString("N2")
                            </strong>
                        </div>

                        @if (suggestion.PayerUserId == Model.CurrentUserId)
                        {
                            <form asp-action="MarkPaid"
                                  method="post"
                                  class="mt-3">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="groupId"
                                       value="@Model.GroupId" />

                                <input type="hidden"
                                       name="payeeUserId"
                                       value="@suggestion.PayeeUserId" />

                                <input type="hidden"
                                       name="amount"
                                       value="@suggestion.Amount" />

                                <div class="input-group">
                                    <input name="note"
                                           class="form-control"
                                           placeholder="Optional note"
                                           maxlength="200" />

                                    <button class="btn btn-success"
                                            type="submit">
                                        Mark as Paid
                                    </button>
                                </div>
                            </form>
                        }
                    </div>
                }
            }
        </div>
    </div>

    @* Pending settlements *@
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Pending settlements</h5>
        </div>

        <div class="list-group list-group-flush">
            @if (!Model.PendingSettlements.Any())
            {
                <div class="list-group-item text-muted">
                    No pending settlements.
                </div>
            }
            else
            {
                @foreach (var settlement in Model.PendingSettlements)
                {
                    <a asp-action="Details"
                       asp-route-id="@settlement.Id"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <span>
                            @(settlement.Payer?.FullName
                                ?? settlement.Payer?.UserName
                                ?? "User")
                            <span class="text-muted">→</span>
                            @(settlement.Payee?.FullName
                                ?? settlement.Payee?.UserName
                                ?? "User")
                        </span>

                        <span class="text-end">
                            <strong>
                                @group.CurrencyCode
                                @settlement.Amount.ToString("N2")
                            </strong>
                            <span class="badge bg-warning text-dark ms-2">
                                Pending
                            </span>
                        </span>
                    </a>
                }
            }
        </div>
    </div>

    @* Settlement history *@
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Settlement History</h5>
        </div>

        <div class="list-group list-group-flush">
            @if (!Model.SettlementHistory.Any())
            {
                <div class="list-group-item text-muted">
                    No completed or disputed settlements yet.
                </div>
            }
            else
            {
                @foreach (var settlement in Model.SettlementHistory)
                {
                    var isCompleted =
                        settlement.Status == SettlementStatus.Completed;

                    <a asp-action="Details"
                       asp-route-id="@settlement.Id"
                       class="list-group-item list-group-item-action">

                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div>
                                <div>
                                    <strong>
                                        @(settlement.Payer?.FullName
                                            ?? settlement.Payer?.UserName
                                            ?? "User")
                                    </strong>

                                    <span class="text-muted">paid</span>

                                    <strong>
                                        @(settlement.Payee?.FullName
                                            ?? settlement.Payee?.UserName
                                            ?? "User")
                                    </strong>
                                </div>

                                <small class="text-muted">
                                    Created:
                                    @settlement.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </small>

                                @if (settlement.ConfirmedAt.HasValue)
                                {
                                    <br />
                                    <small class="text-muted">
                                        Confirmed:
                                        @settlement.ConfirmedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                    </small>
                                }

                                @if (!string.IsNullOrWhiteSpace(settlement.Note))
                                {
                                    <div class="small mt-1">
                                        Note: @settlement.Note
                                    </div>
                                }
                            </div>

                            <div class="text-end">
                                <strong>
                                    @group.CurrencyCode
                                    @settlement.Amount.ToString("N2")
                                </strong>

                                <div class="mt-1">
                                    @if (isCompleted)
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Disputed
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</div>
