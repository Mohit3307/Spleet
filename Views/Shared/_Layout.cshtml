@using Microsoft.AspNetCore.Identity
@using Spleet.Models
@inject UserManager<User> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Spleet</title>
    <meta name="description" content="Spleet - simple expense sharing for groups." />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="app-header">
        <div class="container app-nav">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">S</span>
                <span>Spleet</span>
            </a>

            <nav class="nav-links">
                <a asp-controller="Home" asp-action="Index">Dashboard</a>
                <a asp-controller="Groups" asp-action="Index">Groups</a>
            </nav>

            <div class="nav-user">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <main class="app-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container footer-inner">
            <span>© @DateTime.Now.Year Spleet</span>
            <span>Simple expense sharing.</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
